# Optional: Gemini commentary, with Groq then Claude fallback and local phrases as the last resort.
VITE_LLM_COMMENTARY=true
# Server-side only. Never prefix API keys with VITE_.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# Optional first fallback:
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# Optional last fallback (uses your Anthropic API billing when called):
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Deploy token da Vercel. Opcional e usado apenas pela CLI local (`npx vercel ...`);
# a aplicação nunca lê esta variável. Crie em https://vercel.com/account/settings/tokens
# O deploy automático do GitHub Actions não usa este arquivo: lá o valor precisa
# estar em Settings -> Secrets and variables -> Actions, junto de VERCEL_ORG_ID
# e VERCEL_PROJECT_ID. Veja docs/vercel-deploy.md.
VERCEL_TOKEN=
